{
  "version": 2,
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/auth-api/health", "dest": "/api/health" },
    { "src": "/api/auth-api/check-app-status", "dest": "/api/check-app-status" },
    { "src": "/api/auth-api/login", "dest": "/api/login" },
    { "src": "/api/auth-api/log-login", "dest": "/api/log-login" },
    { "src": "/api/auth-api/get-expiration", "dest": "/api/get-expiration" },
    { "src": "/api/interactions", "dest": "/api/interactions" }
  ]
}
